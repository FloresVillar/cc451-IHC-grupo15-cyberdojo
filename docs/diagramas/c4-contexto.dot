digraph C4 {
  graph [rankdir=TB, fontname="DejaVu Sans", bgcolor=white, pad=0.3, nodesep=0.8, ranksep=0.8, label="C4 · Nivel 1: Diagrama de contexto del sistema CyberDojo (v0.3, PC03)", labelloc=t, fontsize=16];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, fontcolor=white, color="#0b3d6e", margin="0.2,0.12"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#555555", fontcolor="#333333"];
  colab [label="Colaborador-aprendiz\n[Persona]\n\nContador, desarrollador o recepción.\nEntrena con combates por chat y voz\ny conversa con el sensei.", fillcolor="#08427b"];
  admin [label="Responsable de seguridad / TI\n[Persona]\n\nCrea salas y torneos, aprueba\nescenarios generados y ve métricas.", fillcolor="#08427b"];
  sys [label="CyberDojo\n[Sistema de software]\n\nPWA de concientización en ciberseguridad:\nescenarios generados por LLM, llamadas de vishing por voz,\nsensei conversacional, perfil adaptativo, salas y torneos en vivo.", fillcolor="#1168bd", width=4.8];
  llm [label="Proveedor LLM\n[Sistema externo]\n\nAnthropic, OpenAI (o compatible: Groq,\nOpenRouter, LM Studio), Gemini u Ollama local.\nGenera escenarios, evalúa respuestas y responde.", fillcolor="#8a8a8a", color="#6b6b6b"];
  voz [label="Motor de voz del navegador\n[Sistema externo]\n\nWeb Speech API: síntesis (TTS)\ny reconocimiento (STT) en es-PE.", fillcolor="#8a8a8a", color="#6b6b6b"];
  cam [label="Cámara del celular\n[Sistema externo]\n\nLee el QR de la sala y abre\nla PWA con el código.", fillcolor="#8a8a8a", color="#6b6b6b"];
  colab -> sys [label="Hace combates, habla en llamadas,\npregunta al sensei y compite [HTTP(S) + SSE]"];
  admin -> sys [label="Configura torneos, aprueba\nescenarios, exporta CSV [HTTP(S)]"];
  sys -> llm [label="Pide escenarios, evaluaciones y\nrespuestas [HTTPS/JSON o localhost:11434]"];
  sys -> voz [label="Sintetiza y transcribe voz\n(en el dispositivo del usuario)"];
  colab -> cam [label="Escanea QR", style=dashed]; cam -> sys [label="abre /app/#sala=CÓDIGO", style=dashed];
}
