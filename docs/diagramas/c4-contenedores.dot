digraph C4 {
  graph [rankdir=TB, fontname="DejaVu Sans", bgcolor=white, pad=0.3, nodesep=0.6, ranksep=0.7, label="C4 · Nivel 2: Diagrama de contenedores (implementación v0.3)", labelloc=t, fontsize=16, compound=true];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, fontcolor=white, color="#0b3d6e", margin="0.18,0.1"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#555555", fontcolor="#333333"];
  colab [label="Colaborador\n[Persona]", fillcolor="#08427b"];
  admin [label="Admin de TI\n[Persona]", fillcolor="#08427b"];
  subgraph cluster_sys { label="CyberDojo [Sistema]"; style="dashed,rounded"; color="#1168bd"; fontname="DejaVu Sans"; fontsize=12; fontcolor="#1168bd";
    pwa [label="PWA cliente\n[HTML + CSS + JavaScript, Service Worker]\n\n16 pantallas, voz (Web Speech API), reglas\nde personalización offline, cola de sincronización,\ncaché del banco de escenarios.", fillcolor="#438dd5"];
    api [label="API de aplicación + tiempo real\n[Node.js 18+ (node:http), sin frameworks]\n\nAuth JWT (1 h), perfiles, combates, evaluación,\nsalas/torneos por Server-Sent Events,\nmétricas agregadas, revisión de escenarios.", fillcolor="#438dd5"];
    gw  [label="LLM Gateway\n[Módulo Node.js: src/llm/]\n\nInterfaz única + 5 adaptadores.\nGuardrails (.test, marcas ficticias),\nvalidación, timeout y fallback.", fillcolor="#438dd5"];
    db  [label="Almacén de datos\n[Archivo JSON: data/runtime/db.json]\n\nUsuarios, perfiles adaptativos, combates,\nsalas, torneos, escenarios generados.", shape=cylinder, fillcolor="#438dd5"];
    bank[label="Datos simulados y banco\n[JSON versionado: data/]\n\n15 escenarios, 18 usuarios, 165 combates,\nFAQ del sensei, borradores de IA.", shape=folder, fillcolor="#438dd5"];
  }
  llm [label="Proveedor LLM\n[Anthropic / OpenAI / Gemini / Ollama]", fillcolor="#8a8a8a", color="#6b6b6b"];
  voz [label="Web Speech API\n[navegador]", fillcolor="#8a8a8a", color="#6b6b6b"];
  colab -> pwa [label="Usa [HTTP(S)]"]; admin -> pwa [label="Usa (vista admin P15)"];
  pwa -> api [label="REST/JSON + EventSource (SSE)"];
  pwa -> voz [label="TTS / STT"];
  api -> gw [label="generarEscenario()\nevaluarRespuesta()\nconversar()"]; gw -> llm [label="HTTPS / localhost:11434"]; gw -> bank [label="semilla y fallback"];
  api -> db [label="lectura/escritura atómica"]; db -> bank [label="se crea desde", style=dashed];
}
