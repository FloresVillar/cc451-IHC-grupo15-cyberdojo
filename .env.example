# ---- Servidor ----
PORT=8080
# Modo demo: el torneo de ejemplo arranca al iniciar y otros equipos suman puntos simulados (1 = sí, 0 = no)
DEMO=1
# Código de organización que se pide al ingresar
ORG_CODE=KALLPA
# Secreto para firmar los JWT (si se deja vacío se genera uno y se guarda en la base local)
JWT_SECRET=
# HTTPS opcional (necesario para el micrófono desde el celular)
HTTPS_CERT=
HTTPS_KEY=

# ---- LLM ----
# Proveedor: mock | groq | gemini | anthropic | openai | ollama
LLM_PROVIDER=groq
# Modelo (vacío = el predeterminado de cada proveedor)
LLM_MODEL=allam-2-7b
# Tiempo máximo antes de usar el banco de escenarios (ms). Con Ollama en una laptop usar 60000.
LLM_TIMEOUT_MS=20000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Para APIs compatibles con OpenAI (Groq, OpenRouter, LM Studio): https://api.groq.com/openai/v1
OPENAI_BASE_URL=
GEMINI_API_KEY=
# Groq: key en https://console.groq.com/keys (modelo por defecto: llama-3.3-70b-versatile)
GROQ_API_KEY=
OLLAMA_URL=http://localhost:11434
